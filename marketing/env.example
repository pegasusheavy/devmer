# Database
DATABASE_URL="postgresql://user:password@localhost:5432/devmer_marketing?schema=public"

# Optional: Direct URL for migrations (if using connection pooling)
# DIRECT_URL="postgresql://user:password@localhost:5432/devmer_marketing?schema=public"

# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Authentication (if using)
JWT_SECRET="your-jwt-secret-change-in-production"
SESSION_SECRET="your-session-secret-change-in-production"

# Email (for newsletters, contact forms)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="hello@devmer.io"

# Analytics (optional)
ANALYTICS_ID=""

# Feature flags
ENABLE_WAITLIST="true"
ENABLE_BLOG="true"
ENABLE_ANALYTICS="true"
